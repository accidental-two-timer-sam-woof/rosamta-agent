cask "rosamta" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPO@/releases/download/v#{version}/rosamta-#{version}-macos-universal.dmg"
  name "rosamta"
  desc "Cross-shell, cross-host dotfile manager"
  homepage "https://github.com/@REPO@"

  depends_on macos: ">= :ventura"

  app "rosamta.app"
  binary "#{appdir}/rosamta.app/Contents/MacOS/rosamta"
  binary "#{appdir}/rosamta.app/Contents/MacOS/rosamta", target: "rsmt"
end
